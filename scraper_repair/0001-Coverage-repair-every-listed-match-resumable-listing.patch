+"""Coverage repair against a real PostgreSQL (set HLTV_TEST_DSN): the manifest, timestamps that are
+never rewritten, revision ids on stat rows, and a staged revision from creation to promotion."""
+
+import os
+from datetime import date, datetime, timedelta, timezone
+
+import psycopg2
+import pytest
+from conftest import FakeFetcher, load
+from hltv_scraper import acceptance, pipeline, revisions
+from hltv_scraper.db import Database
+from hltv_scraper.models import Result
+from hltv_scraper.parsers import parse_match, parse_rankings, parse_results
+
+MATCH_URL = "https://www.hltv.org/matches/2394892/tyloo-vs-9z-iem-cologne-major-2026-stage-2"
+BO1_URL = "https://www.hltv.org/matches/2394890/vitality-vs-spirit-iem-cologne-major-2026-stage-2"
+START, END = date(2026, 5, 1), date(2026, 6, 30)
+EMPTY = "<html><body></body></html>"
+
+
+def seeded(db, html=None):
+    db.save_rankings(parse_rankings(load("rankings.html")), on=date(2026, 6, 10))
+    match = parse_match(load("match_tyloo_9z.html"), 2394892)
+    db.save_match(match, html, MATCH_URL if html else "")
+    return match
+
+
+def one(db, sql, params=None):
+    with db.con.cursor() as cur:
+        cur.execute(sql, params)
+        row = cur.fetchone()
+    db.con.commit()
+    return row
+
+
+def test_manifest_accounts_for_every_listed_match(db):
+    rows = parse_results(load("results.html"))          # TYLOO-9z, Vitality-Spirit, a forfeit
+    db.record_listing(rows, "results", "u", 0)
+    db.record_listing(rows, "results", "u", 0)          # listed again: still one 'discovered' each
+    db.enqueue([r for r in rows if not r.is_forfeit])
+    seeded(db, load("match_tyloo_9z.html"))
+    db.mark_failed(2394890, "TimeoutError: page did not load")
+    assert db.manifest_accounting() == {"discovered": 3, "stored": 1, "skipped": 1, "unavailable": 0,
+                                        "failed": 1, "pending": 0}
+    assert db.listed_match_ids() == {2394892, 2394890, 2394880}
+    assert one(db, "SELECT attempt, detail FROM result_manifest WHERE kind = 'failed'") == (
+        1, "TimeoutError: page did not load")
+
+
+def test_manifest_is_append_only(db):
+    db.record_listing(parse_results(load("results.html")), "results", "u", 0)
+    for sql in ("UPDATE result_manifest SET detail = 'x'", "DELETE FROM result_manifest", "TRUNCATE result_manifest"):
+        with pytest.raises(psycopg2.Error, match="append-only"):
+            with db.con, db.con.cursor() as cur:
+                cur.execute(sql)
+    assert one(db, "SELECT count(*) FROM result_manifest")[0] == 4   # 3 discovered + 1 skipped (forfeit)
+
+
+def test_old_match_without_stats_becomes_unavailable_not_failed(db):
+    old = Result(1, "A", 2, "B", 0, "", "https://www.hltv.org/matches/1/a-vs-b", "bo3",
+                 played_at=datetime.now(timezone.utc) - timedelta(days=30))
+    new = Result(2, "C", 2, "D", 0, "", "https://www.hltv.org/matches/2/c-vs-d", "bo3",
+                 played_at=datetime.now(timezone.utc))
+    db.record_listing([old, new], "results", "u", 0)
+    db.enqueue([old, new])
+    for _ in range(2):
+        db.mark_waiting(1, "no player statistics", minutes=0)
+        db.mark_waiting(2, "no player statistics", minutes=0)
+    assert dict(db.frame("SELECT matchid, status FROM scrape_queue").values.tolist()) == {1: "unavailable",
+                                                                                          2: "waiting"}
+    assert [r.match_id for r in db.pending()] == [2]          # an unavailable match is final
+    acc = db.manifest_accounting()
+    assert (acc["unavailable"], acc["pending"], acc["failed"]) == (1, 1, 0)
+
+
+def test_first_fetch_time_is_written_once(db):
+    html = load("match_tyloo_9z.html")
+    seeded(db, html)
+    first, latest = one(db, "SELECT first_fetched_at, fetched_at FROM raw_pages WHERE matchid = 2394892")
+    assert first is not None and first == latest
+    seeded(db, html)                                          # read again: latest moves, first stays
+    again = one(db, "SELECT first_fetched_at, fetched_at, refetched_at FROM raw_pages WHERE matchid = 2394892")
+    assert again[0] == first and again[1] >= latest and again[2] is not None
+    with pytest.raises(psycopg2.Error, match="written once"):
+        with db.con, db.con.cursor() as cur:
+            cur.execute("UPDATE raw_pages SET first_fetched_at = now() - interval '1 day'")
+    with db.con, db.con.cursor() as cur:
