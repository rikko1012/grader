+"""Coverage repair (2026-10-12), no database needed: the either-team rule, listings that resume
+instead of stopping silently, the staged backfill's plan and the deployment defaults."""
+
+import json
+import re
+from datetime import date, datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from conftest import FakeFetcher, load
+from hltv_scraper import cli, pipeline
+from hltv_scraper.parsers import parse_results
+from test_pipeline import FakeDb, newer_results, pages
+
+START, END = date(2025, 7, 18), date(2026, 10, 11)
+EMPTY = "<html><body><div class='results'></div></body></html>"
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class ListingDb(FakeDb):
+    """FakeDb plus what the staged backfill uses: the manifest and the board scope."""
+
+    def __init__(self, scope=None, **kw):
+        super().__init__(**kw)
+        self.listed = []          # (match_id, source, page)
+        self.scope = scope or {"team_ids": [], "former_team_ids": [], "past_opponent_ids": [], "player_ids": []}
+
+    def record_listing(self, results, source, url, page, tracked=None):
+        self.listed += [(r.match_id, source, page) for r in results]
+
+    def listed_match_ids(self):
+        return {m for m, _, _ in self.listed}
+
+    def board_scope(self, days=450, past_opponents=False):
+        return self.scope
+
+    def team_ids_by_name(self):
+        return {}
+
+
+def test_results_url_filters():
+    assert pipeline.results_url(1, START, END, team=4863) == (
+        "https://www.hltv.org/results?team=4863&startDate=2025-07-18&endDate=2026-10-11&offset=100")
+    assert pipeline.results_url(0, player=7998) == "https://www.hltv.org/results?player=7998"
+
+
+def test_results_rows_carry_their_time_and_team_ids_when_linked():
+    rows = parse_results(load("results.html"))
+    assert rows[0].played_at == datetime(2026, 6, 8, 15, 0, tzinfo=timezone.utc)
+    assert rows[0].team1_id is None                       # the plain results page links no teams
+    linked = load("results.html").replace('<div class="team">TYLOO</div>',
+                                          '<a href="/team/4863/tyloo"><div class="team">TYLOO</div></a>')
+    assert parse_results(linked)[0].team1_id == 4863
+
+
+def test_a_failed_page_saves_a_cursor_and_the_next_run_resumes_there():
+    db = ListingDb()
+    two_pages = {pipeline.results_url(0, START, END): newer_results()}      # page 1 blocked
+    with pytest.raises(pipeline.ListingIncomplete) as e:
+        pipeline.collect_results(FakeFetcher(two_pages), None, set(), max_pages=0, stop_when_caught_up=False,
+                                 start=START, end=END, db=db, source="results", resume=True)
+    assert e.value.page == 1 and {r.match_id for r in e.value.results} == {2399992, 2399990}
+    cursor = json.loads(db.state[pipeline.cursor_key("results", START, END)])
+    assert cursor["complete"] is False and cursor["next_page"] == 1 and "KeyError" in cursor["error"]
+
+    fixed = FakeFetcher({pipeline.results_url(0, START, END): newer_results(),
+                         pipeline.results_url(1, START, END): load("results.html"),
+                         pipeline.results_url(2, START, END): EMPTY})
+    found = pipeline.collect_results(fixed, None, {2399992, 2399990}, max_pages=0, stop_when_caught_up=False,
+                                     start=START, end=END, db=db, source="results", resume=True)
+    assert {r.match_id for r in found} == {2394892, 2394890}
+    assert fixed.requested[0] == pipeline.results_url(0, START, END)   # one page of overlap before page 1
+    assert json.loads(db.state[pipeline.cursor_key("results", START, END)])["complete"] is True
+
+
+def test_catch_up_reads_on_past_a_page_that_failed_last_time():
+    db = ListingDb(known={2394892, 2394890})
+    db.state[pipeline.cursor_key("results:scan")] = json.dumps({"complete": False, "next_page": 1})
+    fetcher = FakeFetcher({pipeline.results_url(0): load("results.html"), pipeline.results_url(1): load("results.html"),
+                           pipeline.results_url(2): EMPTY})
+    pipeline.collect_results(fetcher, None, db.known, max_pages=pipeline.CATCH_UP_PAGES, db=db,
+                             source="results:scan", catch_up=True)
+    # page 0 is caught up, but page 1 failed last time: it is read before the walk may stop
+    assert fetcher.requested == [pipeline.results_url(0), pipeline.results_url(1)]
+    assert json.loads(db.state[pipeline.cursor_key("results:scan")])["complete"] is True
+
+
+def test_catch_up_cap_is_reported_not_silent():
+    fetcher = FakeFetcher({pipeline.results_url(i): newer_results().replace("/matches/2399", f"/matches/{i}2399")
+                           for i in range(3)})
+    db = ListingDb()
+    with pytest.raises(pipeline.ListingIncomplete, match="page cap"):
+        pipeline.collect_results(fetcher, None, set(), max_pages=2, db=db, source="results:scan", catch_up=True)
+    assert json.loads(db.state[pipeline.cursor_key("results:scan")])["next_page"] == 2
+
+
+def test_every_listed_row_is_recorded_including_forfeits_and_known_matches():
+    db = ListingDb(known={2394892})
+    pipeline.collect_results(FakeFetcher(pages()), None, db.known, max_pages=1, db=db, source="results:scan")
+    assert {m for m, _, _ in db.listed} == {2394892, 2394890, 2394880}
+
+
+def board_pages():
+    return {
+        pipeline.results_url(0, START, END): load("results.html"),
+        pipeline.results_url(1, START, END): EMPTY,
+        pipeline.results_url(0, START, END, team=4863): load("results.html"),
+        pipeline.results_url(1, START, END, team=4863): EMPTY,
+        pipeline.results_url(0, START, END, player=7998): newer_results(),
+        pipeline.results_url(1, START, END, player=7998): EMPTY,
+    }
+
+
+def test_backfill_lists_global_board_team_and_player_listings_and_resumes():
+    scope = {"team_ids": [4863], "former_team_ids": [], "past_opponent_ids": [], "player_ids": [7998]}
+    db = ListingDb(scope=scope)
+    report = pipeline.backfill(db, lambda: FakeFetcher(board_pages()), START, END)
+    assert report.sources == {"results": "complete", "team:4863": "complete", "player:7998": "complete"}
+    assert set(db.queue) == {2394892, 2394890, 2399992, 2399990}        # no forfeit, every tier
+    plan = json.loads(db.state["backfill_plan"])
+    assert plan["sources"] == ["results", "team:4863", "player:7998"] and plan["start"] == str(START)
+
+    # round 2 after the first scrape: a former team appears; finished listings are not read again
+    db.scope = {**scope, "former_team_ids": [9996]}
+    more = board_pages()
+    more.update({pipeline.results_url(0, START, END, team=9996): EMPTY})
+    fetcher = FakeFetcher(more)
+    report = pipeline.backfill(db, lambda: fetcher, START, END)
+    assert report.sources["results"] == "complete earlier" and report.sources["team:9996"] == "complete"
+    assert fetcher.requested == [pipeline.results_url(0, START, END, team=9996)]
+    assert json.loads(db.state["backfill_plan"])["sources"] == ["results", "team:4863", "team:9996", "player:7998"]
+
+
+def test_backfill_flags_a_filter_hltv_ignores():
+    """If HLTV ignored ?player=, the 'player listing' would be the whole results listing: stop at a
+    page cap and report it instead of crawling everything once per player."""
+    scope = {"team_ids": [], "former_team_ids": [], "past_opponent_ids": [], "player_ids": [7998]}
+    endless = {pipeline.results_url(i, START, END, player=7998): load("results.html")
+               for i in range(pipeline.FILTERED_MAX_PAGES + 1)}
+    report = pipeline.backfill(ListingDb(scope=scope), lambda: FakeFetcher(endless), START, END, global_listing=False)
+    assert report.incomplete == ["player:7998"] and "filter ignored" in report.sources["player:7998"]
+
+
+def test_player_listings_can_be_left_out_of_the_plan():
+    scope = {"team_ids": [4863], "former_team_ids": [], "past_opponent_ids": [], "player_ids": [7998]}
+    db = ListingDb(scope=scope)
+    pipeline.backfill(db, lambda: FakeFetcher(board_pages()), START, END)
+    report = pipeline.backfill(db, lambda: FakeFetcher(board_pages()), START, END, player_listings=False)
+    assert "player:7998" not in report.sources
+    assert json.loads(db.state["backfill_plan"])["sources"] == ["results", "team:4863"]
+
+
+def test_backfill_keeps_going_when_one_listing_fails():
+    scope = {"team_ids": [4863, 9996], "former_team_ids": [], "past_opponent_ids": [], "player_ids": []}
+    p = board_pages()
+    p.update({pipeline.results_url(0, START, END, team=9996): load("results.html")})   # its page 1 fails
+    report = pipeline.backfill(ListingDb(scope=scope), lambda: FakeFetcher(p), START, END)
+    assert report.sources["team:9996"] == "incomplete at page 1" and report.sources["team:4863"] == "complete"
+    assert report.incomplete == ["team:9996"]
+
+
+def test_backfill_needs_a_staged_revision(monkeypatch):
+    monkeypatch.delenv("HLTV_REVISION", raising=False)
+    assert cli.main(["backfill"]) == 2    # never the live tables
+
+
+def test_dated_update_against_live_tables_is_refused(monkeypatch):
+    monkeypatch.delenv("HLTV_REVISION", raising=False)
+    assert cli.main(["update", "--start-date", "2025-07-18", "--end-date", "2026-10-11"]) == 2
+
+
+def test_defaults_track_every_match():
+    parser = cli.build_parser()
+    for command in (["update"], ["watch"], ["backfill"], ["results"]):
+        assert parser.parse_args(command).top == 0, command
+    import inspect
+    assert inspect.signature(pipeline.update).parameters["top"].default == 0
+    assert inspect.signature(pipeline.watch).parameters["top"].default == 0
+
+
+def test_no_workflow_restricts_to_top_teams():
+    """The deployment must not bring the both-teams-in-today's-top-200 rule back."""
+    for path in (ROOT / ".github" / "workflows").glob("*.yml"):
+        text = path.read_text(encoding="utf-8")
+        for m in re.finditer(r'--top\s+("[^"]*"|\S+)', text):
+            value = m.group(1).strip('"')
+            assert value in ("0", "${{ inputs.top }}"), f"{path.name}: --top {value}"
+        if "top:" in text:
+            block = text[text.index("top:"):text.index("top:") + 300]
+            assert 'default: "0"' in block, path.name
