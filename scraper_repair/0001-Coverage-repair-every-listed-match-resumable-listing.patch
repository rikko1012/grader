+++ b/hltv_scraper/revisions.py
@@ -0,0 +1,446 @@
+"""Staged dataset revisions: a backfill writes into its own schema first, never into the live tables.
+
+A revision is a Postgres schema ``hltv_rev_<n>`` in the same database, registered in
+``hltv_meta.dataset_revisions``:
+
+1. ``create``: the schema gets the scraper's own tables (schema.sql) and a copy of the live tables
+   (``public``), so the revision starts as "live" and the backfill adds to it. Rows copied from
+   live keep ``created_revision_id`` NULL; every row the revision writes carries ``n``. A
+   fingerprint of every live match older than a few days is kept (``base_match_fingerprints``) so
+   it can be shown later that staging changed nothing in ``public``.
+2. backfill / scrape / mapstats run with ``--revision n``: the search path is that schema alone
+   (no fallback to ``public``), so a write can only land in the revision.
+3. ``seal``: only when every planned listing was read to its end and no listed match is still
+   pending. The revision is then immutable: a statement trigger on every table rejects writes, and
+   a fingerprint of each table is stored so immutability can be checked.
+4. ``promote`` (separate, owner-approved, after CS2 Scout's before/after comparison): the matches the
+   revision added are copied into ``public`` in one transaction; nothing already in ``public`` is
+   changed. Those rows keep ``created_revision_id = n`` (``DELETE ... WHERE created_revision_id = n``
+   undoes it).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import subprocess
+
+from psycopg2.extras import Json, execute_values
+
+from .db import Database, _ident, revision_schema
+
+log = logging.getLogger(__name__)
+
+META = "hltv_meta"
+
+META_DDL = """
+CREATE SCHEMA IF NOT EXISTS hltv_meta;
+CREATE TABLE IF NOT EXISTS hltv_meta.dataset_revisions (
+    revision_id  SERIAL PRIMARY KEY,
+    schema       TEXT UNIQUE,
+    job          TEXT NOT NULL,                 -- backfill | team_backfill | reparse | correction ...
+    base_schema  TEXT NOT NULL DEFAULT 'public',
+    started_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
+    seeded_at    TIMESTAMPTZ,                   -- the live copy finished (the revision's base time)
+    finished_at  TIMESTAMPTZ,                   -- sealed
+    git_commit   TEXT,
+    args         JSONB NOT NULL DEFAULT '{}',
+    counts       JSONB NOT NULL DEFAULT '{}',
+    complete     BOOLEAN NOT NULL DEFAULT false,
+    promoted_at  TIMESTAMPTZ,
+    promoted_by  TEXT,
+    discarded_at TIMESTAMPTZ,
+    notes        TEXT
+);
+-- per live match (older than the cut-off) at seed time: shows staging never touched public
+CREATE TABLE IF NOT EXISTS hltv_meta.base_match_fingerprints (
+    revision_id INT NOT NULL REFERENCES hltv_meta.dataset_revisions (revision_id),
+    matchid     INT NOT NULL,
+    md5         TEXT NOT NULL,
+    PRIMARY KEY (revision_id, matchid)
+);
+-- per table of a sealed revision: shows the revision never changed after it was sealed
+CREATE TABLE IF NOT EXISTS hltv_meta.revision_fingerprints (
+    revision_id INT NOT NULL REFERENCES hltv_meta.dataset_revisions (revision_id),
+    table_name  TEXT NOT NULL,
+    row_count   BIGINT NOT NULL,
+    md5         TEXT NOT NULL,
+    column_list TEXT NOT NULL,
+    taken_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
+    PRIMARY KEY (revision_id, table_name)
+);
+
+CREATE OR REPLACE FUNCTION hltv_meta.reject_sealed() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'dataset revision schema % is sealed: % on % rejected', TG_TABLE_SCHEMA, TG_OP, TG_TABLE_NAME;
+END $$;
+
+CREATE OR REPLACE FUNCTION hltv_meta.reject_change() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION '%.% is append-only: % rejected', TG_TABLE_SCHEMA, TG_TABLE_NAME, TG_OP;
+END $$;
+
+-- a sealed revision's row is frozen, except for recording its promotion; it is never deleted
+CREATE OR REPLACE FUNCTION hltv_meta.guard_revision_row() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP = 'DELETE' THEN
+        RAISE EXCEPTION 'dataset revision % cannot be deleted', OLD.revision_id;
+    END IF;
+    IF OLD.complete AND (NEW.schema, NEW.job, NEW.base_schema, NEW.started_at, NEW.seeded_at, NEW.finished_at,
+                         NEW.git_commit, NEW.args, NEW.counts, NEW.complete)
+                        IS DISTINCT FROM
+                        (OLD.schema, OLD.job, OLD.base_schema, OLD.started_at, OLD.seeded_at, OLD.finished_at,
+                         OLD.git_commit, OLD.args, OLD.counts, OLD.complete) THEN
+        RAISE EXCEPTION 'dataset revision % is sealed: only its promotion can be recorded', OLD.revision_id;
+    END IF;
+    IF OLD.promoted_at IS NOT NULL AND (NEW.promoted_at, NEW.promoted_by) IS DISTINCT FROM (OLD.promoted_at, OLD.promoted_by) THEN
+        RAISE EXCEPTION 'dataset revision % was promoted already', OLD.revision_id;
+    END IF;
+    RETURN NEW;
+END $$;
+DROP TRIGGER IF EXISTS dataset_revisions_guard ON hltv_meta.dataset_revisions;
+CREATE TRIGGER dataset_revisions_guard BEFORE UPDATE OR DELETE ON hltv_meta.dataset_revisions
+    FOR EACH ROW EXECUTE FUNCTION hltv_meta.guard_revision_row();
+DROP TRIGGER IF EXISTS base_match_fingerprints_append_only ON hltv_meta.base_match_fingerprints;
+CREATE TRIGGER base_match_fingerprints_append_only BEFORE UPDATE OR DELETE ON hltv_meta.base_match_fingerprints
+    FOR EACH ROW EXECUTE FUNCTION hltv_meta.reject_change();
+DROP TRIGGER IF EXISTS revision_fingerprints_append_only ON hltv_meta.revision_fingerprints;
+CREATE TRIGGER revision_fingerprints_append_only BEFORE UPDATE OR DELETE ON hltv_meta.revision_fingerprints
+    FOR EACH ROW EXECUTE FUNCTION hltv_meta.reject_change();
+"""
+
+# Tables that start empty in a revision: scheduler state and the listing manifest belong to the
+# revision's own runs. raw_pages (the match page archive, large) is copied only with
+# seed_archives; without it map-stats pages are copied without their archived HTML.
+SEED_SKIP = {"scraper_state", "result_manifest"}
+ARCHIVES = {"raw_pages"}
+
+# Match-keyed tables whose live rows are fingerprinted at seed time (data_issues and the page
+# archive are rewritten by routine re-validation / re-fetches, so they are left out).
+FINGERPRINT_TABLES = ("match_overview", "matches", "player_stats", "match_maps", "map_vetoes", "map_headshots",
+                      "map_player_stats", "map_rounds", "map_round_economy")
+# Columns that are bookkeeping, not data: never part of a fingerprint.
+NOT_DATA = {"html_gz", "created_revision_id", "updated_revision_id", "first_fetched_at", "refetched_at"}
+BASE_CUTOFF_DAYS = 3   # live matches newer than this may legitimately change (stats corrections)
+
+# Not merged into the live schema on promotion: live is newer for these (or they are run state).
+PROMOTE_SKIP = {"prop_lines", "prop_grades", "prop_status", "upcoming_matches", "scraper_state", "result_manifest",
+                "mapstats_page_status", "mapstats_status", "weapons_status", "player_weapon_kills", "player_roles",
+                "fantasy_overview", "fantasies"}
+# Copied whole on promotion (rows the live table lacks), not only for the added matches: the live
+# scan then knows the matches the revision found unavailable or failed instead of listing them anew.
+PROMOTE_ALL_ROWS = {"scrape_queue"}
+
+
+def git_commit() -> str:
+    if os.environ.get("GITHUB_SHA"):
+        return os.environ["GITHUB_SHA"]
+    try:
+        return subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, timeout=10,
+                              cwd=os.path.dirname(__file__)).stdout.strip() or "unknown"
+    except Exception:
+        return "unknown"
+
+
+# -- catalogue helpers -------------------------------------------------------------------------
+
+def tables(cur, schema: str) -> list[str]:
+    cur.execute("SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace "
+                "WHERE n.nspname = %s AND c.relkind = 'r' ORDER BY c.relname", (schema,))
+    return [r[0] for r in cur.fetchall()]
+
+
+def columns(cur, schema: str, table: str) -> dict[str, bool]:
+    """Column name -> nullable, in table order ({} when the table does not exist)."""
+    cur.execute("SELECT a.attname, NOT a.attnotnull FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid "
+                "JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = %s AND c.relname = %s "
+                "AND c.relkind = 'r' AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum", (schema, table))
+    return dict(cur.fetchall())
+
+
+def fk_order(cur, schema: str) -> list[str]:
+    """The schema's tables, every referenced table before the tables that reference it."""
+    names = tables(cur, schema)
+    cur.execute("SELECT r.relname, f.relname FROM pg_constraint c JOIN pg_class r ON r.oid = c.conrelid "
+                "JOIN pg_class f ON f.oid = c.confrelid JOIN pg_namespace n ON n.oid = r.relnamespace "
+                "WHERE c.contype = 'f' AND n.nspname = %s", (schema,))
+    deps: dict[str, set[str]] = {t: set() for t in names}
+    for child, parent in cur.fetchall():
+        if child != parent:
+            deps.setdefault(child, set()).add(parent)
+    order, done = [], set()
+
+    def visit(t, path=()):
+        if t in done:
+            return
+        if t in path:
+            raise RuntimeError(f"foreign key cycle at {t}")
+        for p in sorted(deps.get(t, ())):
+            visit(p, path + (t,))
+        done.add(t)
+        order.append(t)
+
+    for t in names:
+        visit(t)
+    return [t for t in order if t in names]
+
+
+def _q(schema: str, table: str) -> str:
+    return f"{_ident(schema)}.{_ident(table)}"
+
+
+# -- fingerprints --------------------------------------------------------------------------------
+
+def match_fingerprints(cur, schema: str, cutoff, cols_by_table: dict[str, list[str]] | None = None):
+    """md5 per match (matches played before ``cutoff``) over FINGERPRINT_TABLES, and the columns
+    used (so a later check uses exactly the same ones)."""
+    per_match: dict[int, list[str]] = {}
+    used: dict[str, list[str]] = {}
+    for t in FINGERPRINT_TABLES:
+        cols = (cols_by_table or {}).get(t) or [c for c in columns(cur, schema, t) if c not in NOT_DATA]
+        if not cols:
+            continue
+        used[t] = cols
+        row = "ROW(" + ", ".join(f"x.{_ident(c)}" for c in cols) + ")::text"
+        cur.execute(
+            f"SELECT x.matchid, md5(string_agg(md5({row}), '' ORDER BY md5({row}))) FROM {_q(schema, t)} x "
+            f"WHERE x.matchid IN (SELECT matchid FROM {_q(schema, 'match_overview')} WHERE date < %s) "
+            "GROUP BY x.matchid", (cutoff,))
+        for matchid, h in cur.fetchall():
+            per_match.setdefault(matchid, []).append(f"{t}:{h}")
+    return {m: hashlib.md5("|".join(sorted(parts)).encode()).hexdigest() for m, parts in per_match.items()}, used
+
+
+def table_fingerprint(cur, schema: str, table: str) -> tuple[int, str, list[str]]:
+    cols = [c for c in columns(cur, schema, table) if c != "html_gz"]
+    row = "ROW(" + ", ".join(f"x.{_ident(c)}" for c in cols) + ")::text"
+    cur.execute(f"SELECT count(*), coalesce(md5(string_agg(md5({row}), '' ORDER BY md5({row}))), md5('')) "
+                f"FROM {_q(schema, table)} x")
+    n, h = cur.fetchone()
+    return int(n), h, cols
+
+
+# -- create / seed -------------------------------------------------------------------------------
+
+def create_revision(config: dict, job: str = "backfill", args: dict | None = None, seed_archives: bool = False,
+                    notes: str | None = None, base_schema: str = "public") -> int:
+    """Register a new revision, build its schema and fill it with a copy of the live tables.
+    Writes go to hltv_meta and the new schema only; ``base_schema`` is read."""
+    with Database(config) as live:
+        with live.con, live.con.cursor() as cur:
+            cur.execute(META_DDL)
+            cur.execute("INSERT INTO hltv_meta.dataset_revisions (job, base_schema, git_commit, args, notes) "
+                        "VALUES (%s, %s, %s, %s, %s) RETURNING revision_id",
+                        (job, base_schema, git_commit(), Json({**(args or {}), "seed_archives": seed_archives}), notes))
+            rid = cur.fetchone()[0]
+            schema = revision_schema(rid)
+            cur.execute("UPDATE hltv_meta.dataset_revisions SET schema = %s WHERE revision_id = %s", (schema, rid))
+            cur.execute(f"CREATE SCHEMA {_ident(schema)}")
+    log.info("dataset revision %d: schema %s created; copying %s", rid, schema, base_schema)
+    with Database(config, revision=rid) as staged:
+        staged.init_schema(force=True)
+        seed = seed_revision(staged, base_schema, seed_archives)
+        with staged.con, staged.con.cursor() as cur:
+            # from now on every row this schema writes carries the revision id
+            cur.execute(f"CREATE OR REPLACE FUNCTION {_ident(schema)}.current_revision_id() RETURNS INT "
+                        f"LANGUAGE sql IMMUTABLE AS 'SELECT {int(rid)}'")
+            cur.execute("SELECT current_date - %s", (BASE_CUTOFF_DAYS,))
+            cutoff = cur.fetchone()[0]
+            prints, used = match_fingerprints(cur, base_schema, cutoff)
+            execute_values(cur, "INSERT INTO hltv_meta.base_match_fingerprints (revision_id, matchid, md5) VALUES %s",
+                           [(rid, m, h) for m, h in sorted(prints.items())])
+            cur.execute("UPDATE hltv_meta.dataset_revisions SET seeded_at = now(), counts = counts || %s "
+                        "WHERE revision_id = %s",
+                        (Json({"seed": seed, "base_fingerprint": {"cutoff": str(cutoff), "matches": len(prints),
+                                                                  "columns": used}}), rid))
+    log.info("dataset revision %d ready: %s", rid, ", ".join(f"{t} {n['copied']}" for t, n in seed["tables"].items()))
+    return rid
+
+
+def seed_revision(staged: Database, base_schema: str, seed_archives: bool) -> dict:
+    """Copy the base (live) tables into the revision schema in one transaction. Foreign keys are
+    dropped for the copy and put back NOT VALID (live, seeded from a plain export, may hold rows a
+    key would refuse; they are copied as they are and counted), then validated where the rows allow.
+    A column the base lacks is left NULL when it may be (never an invented time); rows that clash
+    with a key are skipped and counted. Returns per-table counts."""
+    schema = staged.current_schema()
+    report: dict = {"base_schema": base_schema, "seed_archives": seed_archives, "tables": {}, "fk_not_valid": []}
+    with staged.con, staged.con.cursor() as cur:
+        cur.execute("SELECT c.conname, r.relname, pg_get_constraintdef(c.oid) FROM pg_constraint c "
+                    "JOIN pg_class r ON r.oid = c.conrelid JOIN pg_namespace n ON n.oid = r.relnamespace "
+                    "WHERE c.contype = 'f' AND n.nspname = %s", (schema,))
+        fks = cur.fetchall()
+        for name, table, _ in fks:
+            cur.execute(f"ALTER TABLE {_q(schema, table)} DROP CONSTRAINT {_ident(name)}")
+        for t in fk_order(cur, schema):
+            if t in SEED_SKIP or (t in ARCHIVES and not seed_archives):
+                continue
+            src = columns(cur, base_schema, t)
+            if not src:
+                continue
+            dst = columns(cur, schema, t)
+            target, values = [], []
+            for c, nullable in dst.items():
+                if c in src:
+                    target.append(c)
+                    values.append("NULL" if (c == "html_gz" and not seed_archives) else f"s.{_ident(c)}")
+                elif nullable:          # e.g. first_fetched_at: unknown for copied rows, never now()
+                    target.append(c)
+                    values.append("NULL")
+            cur.execute(f"SELECT count(*) FROM {_q(base_schema, t)}")
+            base_rows = cur.fetchone()[0]
+            cur.execute(f"INSERT INTO {_q(schema, t)} ({', '.join(map(_ident, target))}) "
+                        f"SELECT {', '.join(values)} FROM {_q(base_schema, t)} s ON CONFLICT DO NOTHING")
+            report["tables"][t] = {"base": int(base_rows), "copied": cur.rowcount}
+        for name, table, definition in fks:
+            cur.execute(f"ALTER TABLE {_q(schema, table)} ADD CONSTRAINT {_ident(name)} {definition} NOT VALID")
+            cur.execute("SAVEPOINT fk")
+            try:
+                cur.execute(f"ALTER TABLE {_q(schema, table)} VALIDATE CONSTRAINT {_ident(name)}")
+                cur.execute("RELEASE SAVEPOINT fk")
+            except Exception as e:  # rows copied from live that the key refuses: kept, enforced for new rows only
+                cur.execute("ROLLBACK TO SAVEPOINT fk")
+                report["fk_not_valid"].append(f"{table}.{name}: {str(e).strip().splitlines()[0][:200]}")
+    for t, n in report["tables"].items():
+        if n["base"] != n["copied"]:
+            log.warning("seed: %s copied %d of %d rows (key clashes in the base)", t, n["copied"], n["base"])
+    return report
+
+
+# -- status / checks / seal ----------------------------------------------------------------------
+
+def listing_status(db: Database) -> dict:
+    """The backfill plan (sources per date range) and each listing's cursor."""
+    with db.con.cursor() as cur:
+        cur.execute("SELECT key, value FROM scraper_state WHERE key LIKE 'listing_cursor:%%' OR key = 'backfill_plan'")
+        rows = dict(cur.fetchall())
+    db.con.commit()
+    plan = json.loads(rows.pop("backfill_plan", "null") or "null") or {}
+    cursors = {k: json.loads(v) for k, v in rows.items()}
+    planned = plan.get("sources", [])
+    start, end = plan.get("start", ""), plan.get("end", "")
+    missing, incomplete = [], []
+    for source in planned:
+        state = cursors.get(f"listing_cursor:{source}:{start}:{end}")
+        if state is None:
+            missing.append(source)
+        elif not state.get("complete"):
+            incomplete.append(source)
+    return {"plan": plan, "planned": len(planned), "not_started": missing, "incomplete": incomplete,
+            "complete": len(planned) - len(missing) - len(incomplete),
+            "cursors_incomplete": sorted(k for k, v in cursors.items() if not v.get("complete"))}
+
+
+def revision_status(db: Database) -> dict:
+    listing = listing_status(db)
+    accounting = db.manifest_accounting()
+    queue = db.queue_summary().to_dict("records")
+    problems = []
+    if not listing["planned"]:
+        problems.append("no backfill plan recorded (run `hltv-scraper backfill --revision N` first)")
+    if listing["not_started"] or listing["incomplete"]:
+        problems.append(f"listings not read to the end: {len(listing['not_started'])} not started, "
+                        f"{len(listing['incomplete'])} incomplete (rerun the backfill: it resumes)")
+    total = sum(accounting[k] for k in ("stored", "skipped", "unavailable", "failed", "pending"))
+    if total != accounting["discovered"]:
+        problems.append(f"manifest does not add up: {total} accounted, {accounting['discovered']} discovered")
+    if accounting["pending"]:
+        problems.append(f"{accounting['pending']} listed matches still pending (rerun scrape)")
+    return {"revision": db.revision, "listing": listing, "manifest": accounting, "queue": queue, "problems": problems}
+
+
+def seal_revision(config: dict, rid: int) -> dict:
+    """Mark revision ``rid`` complete and make its schema read-only. Refuses while a planned
+    listing is incomplete or a listed match is pending."""
+    with Database(config, revision=rid) as db:
+        if db.sealed:
+            raise RuntimeError(f"revision {rid} is sealed already")
+        status = revision_status(db)
+        if status["problems"]:
+            raise RuntimeError(f"revision {rid} cannot be sealed: " + "; ".join(status["problems"]))
+        schema = revision_schema(rid)
+        with db.con, db.con.cursor() as cur:
+            names = tables(cur, schema)
+            prints = {t: table_fingerprint(cur, schema, t) for t in names}
+            execute_values(cur, "INSERT INTO hltv_meta.revision_fingerprints (revision_id, table_name, row_count, md5, column_list) "
+                                "VALUES %s", [(rid, t, n, h, ",".join(c)) for t, (n, h, c) in sorted(prints.items())])
+            for t in names:
+                cur.execute(f"CREATE TRIGGER zz_sealed BEFORE INSERT OR UPDATE OR DELETE OR TRUNCATE ON {_q(schema, t)} "
+                            "FOR EACH STATEMENT EXECUTE FUNCTION hltv_meta.reject_sealed()")
+            counts = {"manifest": status["manifest"], "listing": {k: status["listing"][k] for k in
+                                                                  ("planned", "complete")},
+                      "rows": {t: n for t, (n, _, _) in prints.items()}}
+            cur.execute("UPDATE hltv_meta.dataset_revisions SET complete = true, finished_at = now(), "
+                        "counts = counts || %s WHERE revision_id = %s", (Json({"sealed": counts}), rid))
+    log.info("dataset revision %d sealed (read-only): %s", rid, status["manifest"])
+    return status
+
+
+def discard_revision(config: dict, rid: int, confirm: str) -> None:
+    """Drop the schema of an unsealed, unpromoted revision (a failed or abandoned staging run). The
+    registry row stays, marked discarded."""
+    if confirm != revision_schema(rid):
+        raise RuntimeError(f"pass --confirm {revision_schema(rid)} to discard revision {rid}")
+    with Database(config) as live, live.con, live.con.cursor() as cur:
+        cur.execute("SELECT complete, promoted_at FROM hltv_meta.dataset_revisions WHERE revision_id = %s", (rid,))
+        row = cur.fetchone()
+        if row is None or row[0] or row[1]:
+            raise RuntimeError(f"revision {rid} is missing, sealed or promoted: it is never discarded")
+        cur.execute(f"DROP SCHEMA IF EXISTS {_ident(revision_schema(rid))} CASCADE")
+        cur.execute("UPDATE hltv_meta.dataset_revisions SET discarded_at = now() WHERE revision_id = %s", (rid,))
+
+
+# -- promote -------------------------------------------------------------------------------------
+
+def promote_revision(config: dict, rid: int, confirm: str, approved_by: str) -> dict:
+    """Copy the matches revision ``rid`` added into its base (live) schema, in one transaction,
+    without changing anything already there. Only for a sealed revision, after CS2 Scout's
+    before/after comparison and with the owner's approval (``approved_by`` is recorded)."""
+    schema = revision_schema(rid)
+    if confirm != schema:
+        raise RuntimeError(f"pass --confirm {schema} to promote revision {rid}")
+    if not approved_by.strip():
+        raise RuntimeError("--approved-by is required (who approved the promotion)")
+    with Database(config) as live:
+        with live.con.cursor() as cur:
+            cur.execute("SELECT complete, promoted_at, base_schema, discarded_at FROM hltv_meta.dataset_revisions "
+                        "WHERE revision_id = %s", (rid,))
+            row = cur.fetchone()
+        live.con.commit()
+        if row is None or not row[0] or row[1] or row[3]:
+            raise RuntimeError(f"revision {rid} must exist, be sealed and not promoted or discarded")
+        base = row[2]
+        if live.current_schema() != base:
+            raise RuntimeError(f"connect to the base schema {base} to promote")
+        live.init_schema()   # the base gets this code's tables and columns first (part of the approved step)
+        counts: dict[str, int] = {}
+        with live.con, live.con.cursor() as cur:
+            cur.execute(f"LOCK TABLE {_q(base, 'match_overview')} IN SHARE ROW EXCLUSIVE MODE")
+            cur.execute(f"SELECT matchid FROM {_q(schema, 'match_overview')} EXCEPT "
+                        f"SELECT matchid FROM {_q(base, 'match_overview')}")
+            new_ids = sorted(r[0] for r in cur.fetchall())
+            cur.execute(f"SELECT s.mapid, s.name, b.mapid, b.name FROM {_q(schema, 'maps')} s "
+                        f"JOIN {_q(base, 'maps')} b ON (b.mapid = s.mapid) <> (b.name = s.name)")
+            clash = cur.fetchall()
+            if clash:
+                raise RuntimeError(f"map ids differ between {schema} and {base}: {clash} - resolve before promoting")
+            for t in fk_order(cur, schema):
+                if t in PROMOTE_SKIP:
+                    continue
+                base_cols = columns(cur, base, t)
+                if not base_cols:
+                    continue
+                cols = [c for c in columns(cur, schema, t) if c in base_cols]
+                where = "WHERE s.matchid = ANY(%s)" if "matchid" in cols and t not in PROMOTE_ALL_ROWS else ""
+                cur.execute(f"INSERT INTO {_q(base, t)} ({', '.join(map(_ident, cols))}) "
+                            f"SELECT {', '.join('s.' + _ident(c) for c in cols)} FROM {_q(schema, t)} s {where} "
+                            "ON CONFLICT DO NOTHING", (new_ids,) if where else None)
+                counts[t] = cur.rowcount
+            cur.execute("UPDATE hltv_meta.dataset_revisions SET promoted_at = now(), promoted_by = %s, "
+                        "notes = coalesce(notes || E'\\n', '') || %s WHERE revision_id = %s",
+                        (approved_by, f"promoted: {len(new_ids)} matches, rows {json.dumps(counts)}", rid))
+    log.info("revision %d promoted into %s: %d matches (%s)", rid, base, len(new_ids),
+             ", ".join(f"{t} {n}" for t, n in counts.items() if n))
+    return {"matches": len(new_ids), "rows": counts}
diff --git a/hltv_scraper/schema.sql b/hltv_scraper/schema.sql
index d3fe321..884afec 100644
--- a/hltv_scraper/schema.sql
+++ b/hltv_scraper/schema.sql
@@ -523,3 +523,143 @@ CREATE TABLE IF NOT EXISTS mapstats_page_status (
 );
 CREATE INDEX IF NOT EXISTS map_player_stats_player ON map_player_stats (playerid);
 CREATE INDEX IF NOT EXISTS map_round_economy_team ON map_round_economy (teamid);
+
+-- ---------------------------------------------------------------------------------------------
+-- Coverage repair (2026-10-12): a listing manifest, ingestion times that are never rewritten, and
+-- the dataset revision that created / last changed each stat row (see hltv_scraper/revisions.py).
+
+-- When the match was played (from the results listing) and how often its page showed no
+-- statistics yet: a match still without statistics days after it was played is 'unavailable'.
+ALTER TABLE scrape_queue ADD COLUMN IF NOT EXISTS played_at TIMESTAMPTZ;
+ALTER TABLE scrape_queue ADD COLUMN IF NOT EXISTS waits INT NOT NULL DEFAULT 0;
+
+-- Archived pages: fetched_at stays the latest fetch; first_fetched_at is written once and never
+-- changed (trigger below). The column is added without a default so rows stored before it stay
+-- NULL (unknown) instead of getting an invented time; new rows get now().
+ALTER TABLE raw_pages ADD COLUMN IF NOT EXISTS first_fetched_at TIMESTAMPTZ;
+ALTER TABLE raw_pages ALTER COLUMN first_fetched_at SET DEFAULT now();
+ALTER TABLE raw_pages ADD COLUMN IF NOT EXISTS refetched_at TIMESTAMPTZ;
+ALTER TABLE mapstats_pages ADD COLUMN IF NOT EXISTS first_fetched_at TIMESTAMPTZ;
+ALTER TABLE mapstats_pages ALTER COLUMN first_fetched_at SET DEFAULT now();
+
+CREATE OR REPLACE FUNCTION keep_first_fetched_at() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF OLD.first_fetched_at IS NOT NULL AND NEW.first_fetched_at IS DISTINCT FROM OLD.first_fetched_at THEN
+        RAISE EXCEPTION '%.first_fetched_at is written once: % -> % rejected',
+            TG_TABLE_NAME, OLD.first_fetched_at, NEW.first_fetched_at;
+    END IF;
+    RETURN NEW;
+END $$;
+DROP TRIGGER IF EXISTS raw_pages_first_fetched_at ON raw_pages;
+CREATE TRIGGER raw_pages_first_fetched_at BEFORE UPDATE ON raw_pages
+    FOR EACH ROW EXECUTE FUNCTION keep_first_fetched_at();
+DROP TRIGGER IF EXISTS mapstats_pages_first_fetched_at ON mapstats_pages;
+CREATE TRIGGER mapstats_pages_first_fetched_at BEFORE UPDATE ON mapstats_pages
+    FOR EACH ROW EXECUTE FUNCTION keep_first_fetched_at();
+
+-- The dataset revision this schema writes: a staged revision schema (hltv_rev_<n>) replaces this
+-- function with one returning n; elsewhere it reads the optional setting hltv.revision_id (NULL
+-- when unset). Created only when missing, so a re-run never resets a staged schema's revision.
+DO $$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
+                   WHERE n.nspname = current_schema() AND p.proname = 'current_revision_id') THEN
+        EXECUTE 'CREATE FUNCTION current_revision_id() RETURNS INT LANGUAGE sql STABLE AS '
+                '$f$ SELECT nullif(current_setting(''hltv.revision_id'', true), '''')::INT $f$';
+    END IF;
+END $$;
+
+-- created_revision_id: set once when the row is written; updated_revision_id: the revision of the
+-- last change. Rows copied into a staged revision from the live tables keep NULL (the revision
+-- row records which base they came from).
+CREATE OR REPLACE FUNCTION stamp_updated_revision() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    NEW.created_revision_id := OLD.created_revision_id;
+    NEW.updated_revision_id := coalesce(current_revision_id(), NEW.updated_revision_id);
+    RETURN NEW;
+END $$;
+
+DO $$
+DECLARE t TEXT;
+BEGIN
+    FOREACH t IN ARRAY ARRAY['match_overview', 'matches', 'match_maps', 'player_stats', 'map_player_stats',
+                             'map_headshots', 'map_vetoes', 'map_rounds', 'map_round_economy', 'raw_pages',
+                             'mapstats_pages'] LOOP
+        EXECUTE format('ALTER TABLE %I ADD COLUMN IF NOT EXISTS created_revision_id INT', t);
+        EXECUTE format('ALTER TABLE %I ADD COLUMN IF NOT EXISTS updated_revision_id INT', t);
+        EXECUTE format('ALTER TABLE %I ALTER COLUMN created_revision_id SET DEFAULT current_revision_id()', t);
+        EXECUTE format('DROP TRIGGER IF EXISTS %I ON %I', t || '_revision', t);
+        EXECUTE format('CREATE TRIGGER %I BEFORE UPDATE ON %I FOR EACH ROW EXECUTE FUNCTION stamp_updated_revision()',
+                       t || '_revision', t);
+    END LOOP;
+END $$;
+
+-- Every result a listing showed and what became of it. Append-only (a trigger rejects UPDATE,
+-- DELETE and TRUNCATE). kind: discovered (once per match and source) | present (already stored
+-- when listed) | skipped (forfeit, or no tracked team under a --top limit) | stored | waiting
+-- (page without statistics yet) | unavailable (still none days after the match: not on HLTV) |
+-- failed (error, attempt number). source: results | results:scan | team:<id> | player:<id> | queue.
+CREATE TABLE IF NOT EXISTS result_manifest (
+    id          BIGSERIAL PRIMARY KEY,
+    revision_id INT DEFAULT current_revision_id(),
+    matchid     INT NOT NULL,
+    kind        VARCHAR(16) NOT NULL,
+    source      VARCHAR(48),
+    source_url  TEXT,
+    page        INT,
+    team1       VARCHAR(255),
+    team2       VARCHAR(255),
+    team1_id    INT,
+    team2_id    INT,
+    event_name  VARCHAR(255),
+    format      VARCHAR(32),
+    played_at   TIMESTAMPTZ,
+    attempt     INT,
+    detail      TEXT,
+    at          TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+CREATE UNIQUE INDEX IF NOT EXISTS result_manifest_discovered_once ON result_manifest (matchid, source)
+    WHERE kind = 'discovered';
+CREATE UNIQUE INDEX IF NOT EXISTS result_manifest_present_once ON result_manifest (matchid) WHERE kind = 'present';
+CREATE UNIQUE INDEX IF NOT EXISTS result_manifest_skipped_once ON result_manifest (matchid) WHERE kind = 'skipped';
+CREATE INDEX IF NOT EXISTS result_manifest_match ON result_manifest (matchid, id);
+
+CREATE OR REPLACE FUNCTION reject_change() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION '% is append-only: % rejected', TG_TABLE_NAME, TG_OP;
+END $$;
+DROP TRIGGER IF EXISTS result_manifest_append_only ON result_manifest;
+CREATE TRIGGER result_manifest_append_only BEFORE UPDATE OR DELETE ON result_manifest
+    FOR EACH ROW EXECUTE FUNCTION reject_change();
+DROP TRIGGER IF EXISTS result_manifest_no_truncate ON result_manifest;
+CREATE TRIGGER result_manifest_no_truncate BEFORE TRUNCATE ON result_manifest
+    FOR EACH STATEMENT EXECUTE FUNCTION reject_change();
+
+-- One row per listed match with its state. A match is 'stored' when it is in match_overview;
+-- otherwise its last outcome decides: skipped | unavailable | failed | pending (not attempted yet,
+-- or waiting for statistics). discovered = stored + skipped + unavailable + failed + pending.
+CREATE OR REPLACE VIEW result_manifest_state AS
+WITH d AS (
+    SELECT matchid, min(at) AS first_listed_at, string_agg(DISTINCT source, ' ') AS sources,
+           (array_agg(team1 ORDER BY id))[1] AS team1, (array_agg(team2 ORDER BY id))[1] AS team2,
+           (array_agg(team1_id ORDER BY id) FILTER (WHERE team1_id IS NOT NULL))[1] AS team1_id,
+           (array_agg(team2_id ORDER BY id) FILTER (WHERE team2_id IS NOT NULL))[1] AS team2_id,
+           (array_agg(event_name ORDER BY id))[1] AS event_name, min(played_at) AS played_at,
+           (array_agg(source_url ORDER BY id))[1] AS first_source_url
+    FROM result_manifest WHERE kind = 'discovered' GROUP BY matchid
+), last AS (
+    SELECT DISTINCT ON (matchid) matchid, kind, detail, at
+    FROM result_manifest WHERE kind IN ('skipped', 'stored', 'waiting', 'unavailable', 'failed')
+    ORDER BY matchid, id DESC
+), tries AS (
+    SELECT matchid, count(*) AS attempts FROM result_manifest
+    WHERE kind IN ('stored', 'waiting', 'unavailable', 'failed') GROUP BY matchid
+)
+SELECT d.*,
+       CASE WHEN EXISTS (SELECT 1 FROM match_overview mo WHERE mo.matchid = d.matchid) THEN 'stored'
+            -- skipped by one listing (a --top limit) but queued from another: still to be read
+            WHEN l.kind = 'skipped' AND EXISTS (SELECT 1 FROM scrape_queue q WHERE q.matchid = d.matchid) THEN 'pending'
+            WHEN l.kind IN ('skipped', 'unavailable', 'failed') THEN l.kind
+            ELSE 'pending' END AS state,
+       l.kind AS last_event, l.detail AS last_detail, l.at AS last_event_at, coalesce(t.attempts, 0) AS attempts
+FROM d LEFT JOIN last l USING (matchid) LEFT JOIN tries t USING (matchid);
