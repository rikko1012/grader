+def test_staged_revision_from_creation_to_promotion(db, live):
+    config, schema, created = live
+    seeded(db)                                                # the live table holds TYLOO vs 9z
+    with db.con.cursor() as cur:
+        before, _ = revisions.match_fingerprints(cur, schema, date.today())
+    db.con.commit()
+
+    rid = revisions.create_revision(config, args={"test": True}, base_schema=schema)
+    created.append(rid)
+    with Database(config, revision=rid) as staged:
+        assert staged.current_schema() == f"hltv_rev_{rid}"
+        assert staged.known_match_ids() == {2394892}          # a copy of live ...
+        assert one(staged, "SELECT created_revision_id FROM match_overview") == (None,)   # ... marked as such
+
+        pages = {pipeline.results_url(0, START, END): load("results.html"), pipeline.results_url(1, START, END): EMPTY}
+        report = pipeline.backfill(staged, lambda: FakeFetcher(pages), START, END, board=False)
+        assert report.sources == {"results": "complete"} and report.queued == 1
+        pipeline.scrape_queue(staged, lambda: FakeFetcher({BO1_URL: load("match_tyloo_9z.html")}), retries=0)
+        assert one(staged, "SELECT created_revision_id FROM match_overview WHERE matchid = 2394890") == (rid,)
+        assert staged.manifest_accounting() == {"discovered": 3, "stored": 2, "skipped": 1, "unavailable": 0,
+                                                "failed": 0, "pending": 0}
+        assert revisions.revision_status(staged)["problems"] == []
+
+    # the live tables never saw any of it
+    with db.con.cursor() as cur:
+        assert revisions.match_fingerprints(cur, schema, date.today())[0] == before
+    db.con.commit()
+    assert db.known_match_ids() == {2394892}
+
+    checks = {c.code: c for c in acceptance.run(config, rid)}
+    for code in ("A1", "A2", "A3a", "A3b", "A5", "A6", "A7"):
+        assert checks[code].ok, (code, checks[code].measured)
+
+    with pytest.raises(RuntimeError, match="--confirm"):
+        revisions.promote_revision(config, rid, confirm="hltv_rev_x", approved_by="owner")
+    with pytest.raises(RuntimeError, match="sealed"):          # not sealed yet: no promotion
+        revisions.promote_revision(config, rid, confirm=f"hltv_rev_{rid}", approved_by="owner")
+
+    revisions.seal_revision(config, rid)
+    with Database(config, revision=rid) as staged:
+        assert staged.sealed
+        with pytest.raises(psycopg2.Error, match="sealed"):
+            with staged.con, staged.con.cursor() as cur:
+                cur.execute("DELETE FROM player_stats")
+    assert {c.code: c.ok for c in acceptance.run(config, rid)}["A8"]
+
+    result = revisions.promote_revision(config, rid, confirm=f"hltv_rev_{rid}", approved_by="owner")
+    assert result["matches"] == 1
+    assert db.known_match_ids() == {2394892, 2394890}
+    assert one(db, "SELECT created_revision_id FROM match_overview WHERE matchid = 2394890") == (rid,)
+    assert one(db, "SELECT count(*) FROM player_stats WHERE matchid = 2394890")[0] > 0
+    assert one(db, "SELECT promoted_by FROM hltv_meta.dataset_revisions WHERE revision_id = %s", (rid,)) == ("owner",)
+    with pytest.raises(RuntimeError):
+        revisions.promote_revision(config, rid, confirm=f"hltv_rev_{rid}", approved_by="owner")
+    with pytest.raises(psycopg2.Error, match="sealed"):        # the registry row is frozen too
+        with db.con, db.con.cursor() as cur:
+            cur.execute("UPDATE hltv_meta.dataset_revisions SET counts = '{}' WHERE revision_id = %s", (rid,))
+
