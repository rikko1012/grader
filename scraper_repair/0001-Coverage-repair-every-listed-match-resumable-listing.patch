--- /dev/null
+++ b/hltv_scraper/acceptance.py
@@ -0,0 +1,224 @@
+"""Acceptance checks for a staged dataset revision (``hltv-scraper revision accept N``).
+
+Read-only, except for one write probe that is always rolled back (A5: changing first_fetched_at
+must be rejected). Every check prints what it measured and its target; the run fails when any
+check fails. The same queries are in scripts/acceptance_staged.sql for psql.
+
+  A1 listing completeness   every planned listing (global + team + player) read to its end
+  A2 manifest accounting    discovered = stored + skipped + unavailable + failed + pending, pending 0
+  A3 coverage               stored / eligible >= 99 %  (eligible = listed by HLTV, not a forfeit, played
+                            more than 48 h ago, statistics published: 'unavailable' excluded);
+                            played maps with player stats >= 99 %, with headshots >= 98 %;
+                            unavailable <= 2 % of the listed, non-forfeit matches
+  A4 per board team         each team listing: stored / eligible >= 98 % (or at most 1 missing)
+  A5 ingestion timestamps   triggers in place, rows written by the revision have first_fetched_at,
+                            first_fetched_at <= fetched_at, and a change is rejected
+  A6 live tables untouched  every live match older than the seed cut-off still has the fingerprint it
+                            had when the revision was seeded (changes explained by the live scan's own
+                            re-reads are listed apart); no match stored by the revision appears in the
+                            live tables unless the live scan queued it itself
+  A7 revision ids           stat rows carry NULL (copied from live) or this revision's id, nothing else;
+                            every match the revision stored carries its id
+  A8 sealed = unchanged     (sealed revisions) every table matches its fingerprint taken at seal time
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+
+from . import revisions
+from .db import Database, _ident, revision_schema
+
+STAT_TABLES = ("match_overview", "matches", "match_maps", "player_stats", "map_player_stats", "map_headshots",
+               "map_vetoes", "map_rounds", "map_round_economy", "raw_pages", "mapstats_pages")
+
+
+@dataclass
+class Check:
+    code: str
+    name: str
+    ok: bool
+    measured: str
+    target: str
+
+
+ELIGIBLE = """
+    SELECT s.* FROM result_manifest_state s
+    WHERE s.state <> 'skipped' AND s.state <> 'unavailable'
+      AND coalesce(s.played_at, s.first_listed_at) < now() - interval '48 hours'"""
+
+COVERAGE_SQL = f"""
+    SELECT count(*) AS eligible, count(*) FILTER (WHERE state = 'stored') AS stored,
+           count(*) FILTER (WHERE state = 'failed') AS failed, count(*) FILTER (WHERE state = 'pending') AS pending
+    FROM ({ELIGIBLE}) e"""
+
+MAPS_SQL = f"""
+    WITH m AS (
+        SELECT mm.matchid, mm.mapid, mm.mapstatsid FROM match_maps mm
+        WHERE mm.matchid IN (SELECT matchid FROM ({ELIGIBLE}) e WHERE state = 'stored'))
+    SELECT count(*) AS maps,
+           count(*) FILTER (WHERE EXISTS (SELECT 1 FROM player_stats ps WHERE ps.matchid = m.matchid
+                                          AND ps.mapid = m.mapid AND ps.sideid = 0)) AS with_stats,
+           count(*) FILTER (WHERE EXISTS (SELECT 1 FROM map_headshots h WHERE h.mapstatsid = m.mapstatsid)) AS with_hs
+    FROM m"""
+
+UNAVAILABLE_SQL = """
+    SELECT count(*) FILTER (WHERE state = 'unavailable'), count(*) FILTER (WHERE state <> 'skipped')
+    FROM result_manifest_state"""
+
+TEAM_SQL = f"""
+    WITH listed AS (
+        SELECT DISTINCT split_part(source, ':', 2)::int AS teamid, matchid
+        FROM result_manifest WHERE kind = 'discovered' AND source LIKE 'team:%%')
+    SELECT l.teamid, t.name, count(*) AS eligible, count(*) FILTER (WHERE e.state = 'stored') AS stored
+    FROM listed l JOIN ({ELIGIBLE}) e USING (matchid) LEFT JOIN teams t ON t.teamid = l.teamid
+    GROUP BY l.teamid, t.name ORDER BY stored::float / greatest(count(*), 1), l.teamid"""
+
+
+def _one(cur, sql, params=None):
+    cur.execute(sql, params)
+    return cur.fetchone()
+
+
+def run(config: dict, rid: int) -> list[Check]:
+    checks: list[Check] = []
+    schema = revision_schema(rid)
+    with Database(config, revision=rid) as db:
+        cur = db.con.cursor()
+        # A1
+        listing = revisions.listing_status(db)
+        ok = listing["planned"] > 0 and not listing["not_started"] and not listing["incomplete"] \
+            and not listing["cursors_incomplete"]
+        checks.append(Check("A1", "listing completeness", ok,
+                            f"{listing['complete']}/{listing['planned']} planned listings complete; not started "
+                            f"{listing['not_started'][:5]}, incomplete {listing['incomplete'][:5]}",
+                            "every planned listing read to its end"))
+        # A2
+        acc = db.manifest_accounting()
+        total = sum(acc[k] for k in ("stored", "skipped", "unavailable", "failed", "pending"))
+        checks.append(Check("A2", "manifest accounting", total == acc["discovered"] and acc["pending"] == 0,
+                            json.dumps(acc), "discovered = stored + skipped + unavailable + failed + pending; pending 0"))
+        # A3
+        eligible, stored, failed, pending = _one(cur, COVERAGE_SQL)
+        ratio = stored / eligible if eligible else 0.0
+        checks.append(Check("A3a", "stored / eligible HLTV listing", eligible > 0 and ratio >= 0.99,
+                            f"{stored}/{eligible} = {ratio:.4f} (failed {failed}, pending {pending})", ">= 0.99"))
+        maps, with_stats, with_hs = _one(cur, MAPS_SQL)
+        checks.append(Check("A3b", "played maps with player stats", maps > 0 and with_stats / maps >= 0.99,
+                            f"{with_stats}/{maps}", ">= 0.99"))
+        checks.append(Check("A3c", "played maps with headshots", maps > 0 and with_hs / maps >= 0.98,
+                            f"{with_hs}/{maps}", ">= 0.98"))
+        unavailable, listed = _one(cur, UNAVAILABLE_SQL)
+        checks.append(Check("A3d", "unavailable on HLTV (no stats)", not listed or unavailable / listed <= 0.02,
+                            f"{unavailable}/{listed}", "<= 0.02 (reported apart from failures)"))
+        # A4
+        cur.execute(TEAM_SQL)
+        teams = cur.fetchall()
+        bad = [(tid, name, s, e) for tid, name, e, s in teams if e and s / e < 0.98 and e - s > 1]
+        checks.append(Check("A4", "per board team coverage", bool(teams) and not bad,
+                            f"{len(teams)} team listings; below target: " + "; ".join(
+                                f"{name or tid} {s}/{e}" for tid, name, s, e in bad[:15]),
+                            ">= 0.98 per team (or at most 1 missing)"))
+        # A5
+        cur.execute("SELECT c.relname FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid "
+                    "JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = %s "
+                    "AND t.tgname IN ('raw_pages_first_fetched_at', 'mapstats_pages_first_fetched_at')", (schema,))
+        triggers = {r[0] for r in cur.fetchall()}
+        missing_first = _one(cur, "SELECT (SELECT count(*) FROM raw_pages WHERE created_revision_id = %s "
+                                  "AND first_fetched_at IS NULL) + (SELECT count(*) FROM mapstats_pages "
+                                  "WHERE created_revision_id = %s AND first_fetched_at IS NULL)", (rid, rid))[0]
+        inverted = _one(cur, "SELECT (SELECT count(*) FROM raw_pages WHERE first_fetched_at > fetched_at) "
+                             "+ (SELECT count(*) FROM mapstats_pages WHERE first_fetched_at > fetched_at)")[0]
+        probe = "no row to probe"
+        rejected = True
+        row = _one(cur, "SELECT matchid FROM raw_pages WHERE first_fetched_at IS NOT NULL LIMIT 1")
+        db.con.commit()
+        if row:
+            try:
+                cur.execute("UPDATE raw_pages SET first_fetched_at = first_fetched_at - interval '1 day' "
+                            "WHERE matchid = %s", row)
+                rejected, probe = False, "a change to first_fetched_at was ACCEPTED"
+            except Exception as e:   # the trigger (or the seal) refused it
+                probe = f"change rejected ({str(e).strip().splitlines()[0][:80]})"
+            finally:
+                db.con.rollback()    # never keep the probe
+        checks.append(Check("A5", "ingestion timestamps never rewritten",
+                            triggers == {"raw_pages", "mapstats_pages"} and not missing_first and not inverted
+                            and rejected,
+                            f"triggers on {sorted(triggers)}; revision rows without first_fetched_at {missing_first}; "
+                            f"first > latest {inverted}; probe: {probe}",
+                            "triggers on both tables, 0, 0, change rejected"))
+        # A6
+        checks.append(_live_untouched(cur, rid, schema))
+        db.con.commit()
+        # A7
+        foreign = 0
+        for t in STAT_TABLES:
+            foreign += _one(cur, f"SELECT count(*) FROM {_ident(t)} WHERE created_revision_id IS DISTINCT FROM %s "
+                                 "AND created_revision_id IS NOT NULL", (rid,))[0]
+        unstamped = _one(cur, "SELECT count(DISTINCT m.matchid) FROM result_manifest m "
+                              "JOIN match_overview mo USING (matchid) WHERE m.kind = 'stored' "
+                              "AND mo.created_revision_id IS DISTINCT FROM %s", (rid,))[0]
+        checks.append(Check("A7", "revision ids on stat rows", not foreign and not unstamped,
+                            f"rows with another revision id {foreign}; matches stored by the revision without its id "
+                            f"{unstamped}", "0 and 0"))
+        db.con.commit()
+        # A8
+        if db.sealed:
+            cur.execute("SELECT table_name, row_count, md5 FROM hltv_meta.revision_fingerprints WHERE revision_id = %s",
+                        (rid,))
+            stored_prints = {t: (n, h) for t, n, h in cur.fetchall()}
+            changed = [t for t, (n, h) in stored_prints.items()
+                       if revisions.table_fingerprint(cur, schema, t)[:2] != (n, h)]
+            cur.execute("SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid "
+                        "JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = %s AND t.tgname = 'zz_sealed'",
+                        (schema,))
+            guarded = cur.fetchone()[0]
+            checks.append(Check("A8", "sealed revision unchanged", not changed and guarded == len(stored_prints),
+                                f"tables changed since sealing: {changed}; tables guarded {guarded}/{len(stored_prints)}",
+                                "none changed, every table guarded"))
+        db.con.commit()
+    return checks
+
+
+def _live_untouched(cur, rid: int, schema: str) -> Check:
+    cur.execute("SELECT base_schema, seeded_at, counts -> 'base_fingerprint' FROM hltv_meta.dataset_revisions "
+                "WHERE revision_id = %s", (rid,))
+    base, seeded_at, meta = cur.fetchone()
+    if not seeded_at or not meta:
+        return Check("A6", "live tables untouched", False, "revision was never fully seeded", "seeded revision")
+    then = dict(_rows(cur, "SELECT matchid, md5 FROM hltv_meta.base_match_fingerprints WHERE revision_id = %s", (rid,)))
+    now, _ = revisions.match_fingerprints(cur, base, meta["cutoff"], meta["columns"])
+    changed = sorted(m for m, h in then.items() if now.get(m) != h)
+    explained = set()
+    if changed:   # the live scan re-reads a match when HLTV corrects it: that is the live scan, not staging
+        explained = {r[0] for r in _rows(cur, f"SELECT matchid FROM {_ident(base)}.scrape_queue "
+                                              "WHERE matchid = ANY(%s) AND updated_at >= %s", (changed, seeded_at))}
+    unexplained = [m for m in changed if m not in explained]
+    # the live scan always queues a match before it stores it: a revision match in live without a
+    # live queue row (or carrying this revision's id there) could only have come from staging
+    leaked = [r[0] for r in _rows(
+        cur, f"SELECT mo.matchid FROM {_ident(schema)}.match_overview mo "
+             f"JOIN {_ident(base)}.match_overview lv USING (matchid) "
+             f"LEFT JOIN {_ident(base)}.scrape_queue q ON q.matchid = mo.matchid "
+             "WHERE mo.created_revision_id = %s AND q.matchid IS NULL", (rid,))]
+    if "created_revision_id" in revisions.columns(cur, base, "match_overview"):
+        leaked += [r[0] for r in _rows(cur, f"SELECT matchid FROM {_ident(base)}.match_overview "
+                                            "WHERE created_revision_id = %s", (rid,))]
+    return Check("A6", "live tables untouched by staging", not unexplained and not leaked,
+                 f"{len(then)} live matches fingerprinted at seed; changed {len(changed)} "
+                 f"(explained by the live scan's own re-reads {len(explained)}, unexplained {unexplained[:10]}); "
+                 f"revision matches in live without the live scan queueing them: {leaked[:10]}",
+                 "0 unexplained, 0 leaked")
+
+
+def _rows(cur, sql, params=None):
+    cur.execute(sql, params)
+    return cur.fetchall()
+
+
+def markdown(rid: int, checks: list[Check]) -> str:
+    lines = [f"## Acceptance: dataset revision {rid}", "", "| | Check | Measured | Target |", "|---|---|---|---|"]
+    lines += [f"| {'PASS' if c.ok else 'FAIL'} | {c.code} {c.name} | {c.measured} | {c.target} |" for c in checks]
+    return "\n".join(lines) + "\n"
