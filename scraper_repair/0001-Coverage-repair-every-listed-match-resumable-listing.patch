diff --git a/scripts/acceptance_staged.sql b/scripts/acceptance_staged.sql
new file mode 100644
index 0000000..4396ae0
--- /dev/null
+++ b/scripts/acceptance_staged.sql
@@ -0,0 +1,137 @@
+-- Acceptance checks for a staged dataset revision, for psql (the same checks as
+-- `hltv-scraper revision accept N`, which also runs A6 / A8 - the fingerprint comparisons).
+--
+--   psql "$HLTV_DB_DSN" -v rev=3 -v base=public -f scripts/acceptance_staged.sql
+--
+-- Read-only except the A5 probe at the end, which tries to change first_fetched_at inside a
+-- DO block and is always rolled back. Each query prints its measurement and a pass column.
+
+\set ON_ERROR_STOP on
+SELECT set_config('search_path', 'hltv_rev_' || :rev, false) AS search_path;
+SELECT revision_id, schema, job, started_at, seeded_at, finished_at, complete, promoted_at, git_commit
+FROM hltv_meta.dataset_revisions WHERE revision_id = :rev;
+
+-- A1 listing completeness: every planned listing (global + team + player) read to its end
+WITH plan AS (SELECT value::json AS p FROM scraper_state WHERE key = 'backfill_plan'),
+     src AS (SELECT json_array_elements_text(p -> 'sources') AS source, p ->> 'start' AS s, p ->> 'end' AS e
+             FROM plan),
+     cur AS (SELECT key, value::json AS v FROM scraper_state WHERE key LIKE 'listing_cursor:%' OFFSET 0)
+SELECT 'A1' AS check, count(*) AS planned,
+       count(*) FILTER (WHERE coalesce((c.v ->> 'complete')::boolean, false)) AS complete,
+       count(*) FILTER (WHERE c.key IS NULL) AS not_started,
+       count(*) FILTER (WHERE c.key IS NOT NULL AND NOT coalesce((c.v ->> 'complete')::boolean, false)) AS incomplete,
+       count(*) > 0 AND count(*) = count(*) FILTER (WHERE coalesce((c.v ->> 'complete')::boolean, false)) AS pass
+FROM src LEFT JOIN cur c ON c.key = 'listing_cursor:' || src.source || ':' || src.s || ':' || src.e;
+
+-- A1 detail: listings that are not complete (resume point and error)
+SELECT key, value FROM scraper_state
+WHERE key LIKE 'listing_cursor:%' AND value NOT LIKE '%"complete": true%' ORDER BY key LIMIT 50;
+
+-- A2 manifest accounting: discovered = stored + skipped + unavailable + failed + pending, pending = 0
+SELECT 'A2' AS check, count(*) AS discovered,
+       count(*) FILTER (WHERE state = 'stored') AS stored,
+       count(*) FILTER (WHERE state = 'skipped') AS skipped,
+       count(*) FILTER (WHERE state = 'unavailable') AS unavailable,
+       count(*) FILTER (WHERE state = 'failed') AS failed,
+       count(*) FILTER (WHERE state = 'pending') AS pending,
+       count(*) = count(*) FILTER (WHERE state IN ('stored', 'skipped', 'unavailable', 'failed', 'pending'))
+         AND count(*) FILTER (WHERE state = 'pending') = 0 AS pass
+FROM result_manifest_state;
+
+-- A3a coverage vs the eligible HLTV listing: listed, not a forfeit, played > 48 h ago, statistics
+-- published (unavailable excluded) -> stored >= 99 %
+WITH e AS (SELECT * FROM result_manifest_state
+           WHERE state NOT IN ('skipped', 'unavailable')
+             AND coalesce(played_at, first_listed_at) < now() - interval '48 hours')
+SELECT 'A3a' AS check, count(*) AS eligible, count(*) FILTER (WHERE state = 'stored') AS stored,
+       count(*) FILTER (WHERE state = 'failed') AS failed, count(*) FILTER (WHERE state = 'pending') AS pending,
+       round(count(*) FILTER (WHERE state = 'stored')::numeric / nullif(count(*), 0), 4) AS ratio,
+       count(*) > 0 AND count(*) FILTER (WHERE state = 'stored') >= 0.99 * count(*) AS pass
+FROM e;
+
+-- A3b/c played maps of those matches with player stats (>= 99 %) and headshots (>= 98 %)
+WITH e AS (SELECT matchid FROM result_manifest_state
+           WHERE state = 'stored' AND coalesce(played_at, first_listed_at) < now() - interval '48 hours'),
+     m AS (SELECT mm.matchid, mm.mapid, mm.mapstatsid FROM match_maps mm JOIN e USING (matchid))
+SELECT 'A3bc' AS check, count(*) AS maps,
+       count(*) FILTER (WHERE EXISTS (SELECT 1 FROM player_stats ps WHERE ps.matchid = m.matchid
+                                      AND ps.mapid = m.mapid AND ps.sideid = 0)) AS with_stats,
+       count(*) FILTER (WHERE EXISTS (SELECT 1 FROM map_headshots h WHERE h.mapstatsid = m.mapstatsid)) AS with_hs,
+       count(*) FILTER (WHERE EXISTS (SELECT 1 FROM player_stats ps WHERE ps.matchid = m.matchid
+                                      AND ps.mapid = m.mapid AND ps.sideid = 0)) >= 0.99 * count(*)
+         AND count(*) FILTER (WHERE EXISTS (SELECT 1 FROM map_headshots h WHERE h.mapstatsid = m.mapstatsid))
+             >= 0.98 * count(*) AS pass
+FROM m;
+
+-- A3d unavailable on HLTV (listed, no statistics days after the match), reported apart: <= 2 %
+SELECT 'A3d' AS check, count(*) FILTER (WHERE state = 'unavailable') AS unavailable,
+       count(*) FILTER (WHERE state <> 'skipped') AS listed,
+       count(*) FILTER (WHERE state = 'unavailable') <= 0.02 * count(*) FILTER (WHERE state <> 'skipped') AS pass
+FROM result_manifest_state;
+
+-- A3 by month (for the report)
+SELECT to_char(coalesce(played_at, first_listed_at), 'YYYY-MM') AS month, count(*) AS listed,
+       count(*) FILTER (WHERE state = 'stored') AS stored, count(*) FILTER (WHERE state = 'unavailable') AS unavailable,
+       count(*) FILTER (WHERE state = 'failed') AS failed, count(*) FILTER (WHERE state = 'skipped') AS skipped
+FROM result_manifest_state GROUP BY 1 ORDER BY 1;
+
+-- A4 per board team (each team's own HLTV listing is the denominator): >= 98 % or at most 1 missing
+WITH listed AS (SELECT DISTINCT split_part(source, ':', 2)::int AS teamid, matchid
+                FROM result_manifest WHERE kind = 'discovered' AND source LIKE 'team:%'),
+     e AS (SELECT * FROM result_manifest_state
+           WHERE state NOT IN ('skipped', 'unavailable')
+             AND coalesce(played_at, first_listed_at) < now() - interval '48 hours')
+SELECT 'A4' AS check, l.teamid, t.name, count(*) AS eligible, count(*) FILTER (WHERE e.state = 'stored') AS stored,
+       round(count(*) FILTER (WHERE e.state = 'stored')::numeric / count(*), 4) AS ratio,
+       count(*) FILTER (WHERE e.state = 'stored') >= 0.98 * count(*)
+         OR count(*) - count(*) FILTER (WHERE e.state = 'stored') <= 1 AS pass
+FROM listed l JOIN e USING (matchid) LEFT JOIN teams t ON t.teamid = l.teamid
+GROUP BY l.teamid, t.name ORDER BY ratio, l.teamid;
+
+-- A5 ingestion timestamps: triggers present, revision rows have first_fetched_at, first <= latest
+SELECT 'A5' AS check,
+       (SELECT count(*) FROM pg_trigger tg JOIN pg_class c ON c.oid = tg.tgrelid
+        JOIN pg_namespace n ON n.oid = c.relnamespace
+        WHERE n.nspname = 'hltv_rev_' || :rev
+          AND tg.tgname IN ('raw_pages_first_fetched_at', 'mapstats_pages_first_fetched_at')) AS triggers,
+       (SELECT count(*) FROM raw_pages WHERE created_revision_id = :rev AND first_fetched_at IS NULL)
+     + (SELECT count(*) FROM mapstats_pages WHERE created_revision_id = :rev AND first_fetched_at IS NULL) AS missing_first,
+       (SELECT count(*) FROM raw_pages WHERE first_fetched_at > fetched_at)
+     + (SELECT count(*) FROM mapstats_pages WHERE first_fetched_at > fetched_at) AS first_after_latest;
+-- pass: triggers = 2, missing_first = 0, first_after_latest = 0
+
+-- A6 (partial; the full fingerprint comparison is `hltv-scraper revision accept`): no match the
+-- revision stored is in the live tables unless the live scan queued it itself
+SELECT 'A6' AS check, count(*) AS leaked, count(*) = 0 AS pass
+FROM match_overview mo
+JOIN :"base".match_overview lv USING (matchid)
+LEFT JOIN :"base".scrape_queue q ON q.matchid = mo.matchid
+WHERE mo.created_revision_id = :rev AND q.matchid IS NULL;
+
+-- A7 revision ids: stat rows carry NULL (copied from live) or this revision, nothing else
+SELECT 'A7' AS check, sum(n) AS foreign_rows, sum(n) = 0 AS pass FROM (
+    SELECT count(*) AS n FROM match_overview WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM matches WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM match_maps WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM player_stats WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM map_player_stats WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM map_headshots WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM raw_pages WHERE created_revision_id <> :rev
+    UNION ALL SELECT count(*) FROM mapstats_pages WHERE created_revision_id <> :rev) x;
+
+-- A5 probe (rolled back): changing first_fetched_at must be rejected
+DO $$
+DECLARE msg TEXT;
+BEGIN
+    BEGIN
+        UPDATE raw_pages SET first_fetched_at = first_fetched_at - interval '1 day'
+        WHERE matchid = (SELECT matchid FROM raw_pages WHERE first_fetched_at IS NOT NULL LIMIT 1);
+        msg := CASE WHEN FOUND THEN 'FAIL: a change to first_fetched_at was accepted' ELSE 'SKIP: no row to probe' END;
+    EXCEPTION WHEN OTHERS THEN
+        msg := 'PASS: change rejected (' || SQLERRM || ')';
+    END;
+    RAISE NOTICE 'A5 probe: %', msg;
+    IF msg LIKE 'FAIL%' THEN
+        RAISE EXCEPTION '%', msg;   -- also undoes the change
+    END IF;
+END $$;
